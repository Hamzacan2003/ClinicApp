# 1. Derleme Aşaması (.NET 8 SDK)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Proje dosyalarını kopyala ve restore et
COPY ["WebAPI/WebAPI.csproj", "WebAPI/"]
COPY ["Business/Business.csproj", "Business/"]
COPY ["DataAccess/DataAccess.csproj", "DataAccess/"]
RUN dotnet restore "WebAPI/WebAPI.csproj"

# Kalan tüm kaynak kodları kopyala ve derle
COPY . .
WORKDIR "/src/WebAPI"
RUN dotnet publish "WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false

# 2. Çalışma Aşaması (Lightweight ASP.NET Runtime)
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# Medikal dosyaların kaydolacağı klasörü konteyner içinde hazırla
RUN mkdir -p /app/Storage/MedicalUploads

# Port ayarı (Render 8080 veya PORT değişkenini dinler)
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "WebAPI.dll"]